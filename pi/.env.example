# Raspberry Pi 側 MQTT 接続情報
#
# コピーして .env を作成し、`set -a; . ./.env; set +a` などで読み込んでから subscriber.py を実行:
#   cp .env.example .env
#   set -a; . ./.env; set +a
#   python3 subscriber.py

# HiveMQ Cloud のホスト名（wss:// や :ポート は含めない）
MQTT_BROKER=xxxxxxxx.s1.eu.hivemq.cloud
# TLS ポート（8883 を指定すると subscriber.py が自動で TLS を有効化）
MQTT_PORT=8884

# HiveMQ Cloud のアクセス認証情報
MQTT_USERNAME=
MQTT_PASSWORD=

# アプリ画面に表示されるデバイスIDと一致させる
DEVICE_ID=pi

# 任意: 制御する GPIO ピン（BCM番号, 既定 17）
# GPIO_PIN=17
