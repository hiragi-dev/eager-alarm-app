# アプリ側 MQTT 接続情報（開発/テスト用）
#
# このファイルをコピーして .env.local を作成し、値を埋めてください:
#   cp .env.example .env.local
#
# 重要:
# - NEXT_PUBLIC_* はブラウザに配信されるため、ここには「開発用ブローカーの認証情報」だけを置くこと。
# - 本番ビルド(next build)ではこれらは読み込まれません（コードの NODE_ENV 判定で除去）。
#   本番では認証情報はアプリ画面から入力してください。
# - .env.local は Git 管理対象外です（.gitignore 済み）。

# HiveMQ Cloud の WebSocket エンドポイント（TLS: ポート 8884, パス /mqtt）
NEXT_PUBLIC_MQTT_BROKER_URL=wss://xxxxxxxx.s1.eu.hivemq.cloud:8884/mqtt

# HiveMQ Cloud のアクセス認証情報
NEXT_PUBLIC_MQTT_USERNAME=
NEXT_PUBLIC_MQTT_PASSWORD=

# 任意: 開発中に固定したいデバイスID（未指定なら自動生成）
NEXT_PUBLIC_MQTT_DEVICE_ID=
